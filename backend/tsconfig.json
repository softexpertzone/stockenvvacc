{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@prisma/client/config": ["node_modules/@prisma/client/config/index.d.ts"]
    }
  },
  "include": ["src/**/*",
    "prisma.config.js"
  ]
}