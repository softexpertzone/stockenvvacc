generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}

// ==========================================
// 1. IDENTITY, ACCESS & PRIVILEGE MATRIX
// ==========================================

enum UserRole {
  SUPERADMIN
  ADMIN
  MANAGER
  OPERATOR
  PICKER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(ADMIN)
  createdAt DateTime @default(now())

  products           Product[]
  permission         Permission?
  purchaseOrders     PurchaseOrder[]
  salesOrders        SalesOrder[]
  pickTasks          PickList[]          @relation("PickerTasks")
  stockReevaluations StockReevaluation[]
}

model Permission {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  canViewInventory   Boolean @default(true)
  canManageProducts  Boolean @default(false)
  canManageSuppliers Boolean @default(false)
  canProcessPayments Boolean @default(false)
  canHandleReturns   Boolean @default(false)
  canTransferStock   Boolean @default(false)
  canManageSales     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  entity    String // E.g., "BinStock", "ProductVariant"
  entityId  String
  action    String // E.g., "CREATE", "UPDATE"
  operation String // E.g., "STOCK_ADJUSTMENT"
  newValue  Json?
  reason    String?
  userId    String
  createdAt DateTime @default(now())
  meta      Json?

  @@index([entity, entityId, createdAt])
}

// ==========================================
// 2. CATEGORIES & BRANDS
// ==========================================

model Category {
  id           String        @id @default(uuid())
  code         String        @unique
  name         String        @unique
  description  String?
  parentId     String?
  parent       Category?     @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     Category[]    @relation("CategoryHierarchy")
  products     Product[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  putAwayRules PutAwayRule[]

  @@index([parentId])
  @@index([code])
}

model Brand {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String
  slug        String?   @unique
  description String?
  parentId    String?
  path        String?
  isActive    Boolean   @default(true)
  parentBrand Brand?    @relation("BrandToSubBrand", fields: [parentId], references: [id], onDelete: Restrict)
  subBrands   Brand[]   @relation("BrandToSubBrand")
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([name, parentId])
  @@index([path])
  @@index([code])
}

// ==========================================
// 3. PHYSICAL WAREHOUSE HIERARCHY
// ==========================================

model Godown {
  id                 String   @id @default(uuid())
  name               String   @unique
  address            String?
  isDefaultReceiving Boolean  @default(false)
  zones              Zone[]
  bins               Bin[] // Performance shortcut optimization
  createdAt          DateTime @default(now())
}

model Zone {
  id       String @id @default(uuid())
  name     String
  godownId String
  godown   Godown @relation(fields: [godownId], references: [id], onDelete: Cascade)
  rooms    Room[]

  @@unique([name, godownId])
}

model Room {
  id     String  @id @default(uuid())
  name   String
  zoneId String
  zone   Zone    @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  aisles Aisle[]

  @@unique([name, zoneId])
}

model Aisle {
  id     String @id @default(uuid())
  name   String
  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  racks  Rack[]

  @@unique([name, roomId])
}

model Rack {
  id            String  @id @default(uuid())
  name          String
  aisleId       String
  aisle         Aisle   @relation(fields: [aisleId], references: [id], onDelete: Cascade)
  shelves       Shelf[]
  maxWeightKg   Decimal @default(0.0) @db.Decimal(12, 2)
  maxVolumeCm3  Decimal @default(0.0) @db.Decimal(15, 2)
  currentWeight Decimal @default(0.0) @db.Decimal(12, 2)
  currentVolume Decimal @default(0.0) @db.Decimal(15, 2)

  @@unique([name, aisleId])
}

model Shelf {
  id            String  @id @default(uuid())
  name          String
  rackId        String
  rack          Rack    @relation(fields: [rackId], references: [id], onDelete: Cascade)
  bins          Bin[]
  maxWeightKg   Decimal @default(0.0) @db.Decimal(12, 2)
  maxVolumeCm3  Decimal @default(0.0) @db.Decimal(15, 2)
  currentWeight Decimal @default(0.0) @db.Decimal(12, 2)
  currentVolume Decimal @default(0.0) @db.Decimal(15, 2)

  @@unique([name, rackId])
}

model Bin {
  id                       String                  @id @default(uuid())
  name                     String
  shelfId                  String
  shelf                    Shelf                   @relation(fields: [shelfId], references: [id], onDelete: Cascade)
  godownId                 String
  godown                   Godown                  @relation(fields: [godownId], references: [id], onDelete: Cascade)
  isActive                 Boolean                 @default(true)
  maxWeightKg              Decimal                 @default(0.0) @db.Decimal(12, 2)
  maxVolumeCm3             Decimal                 @default(0.0) @db.Decimal(15, 2)
  currentWeight            Decimal                 @default(0.0) @db.Decimal(12, 2)
  currentVolume            Decimal                 @default(0.0) @db.Decimal(15, 2)
  proximityIndex           Int                     @default(50)
  storageClass             String                  @default("GENERAL")
  inventoryBalances        InventoryBalance[]
  sourceLedgerEntries      StockLedger[]           @relation("SourceBin")
  destinationLedgerEntries StockLedger[]           @relation("DestinationBin")
  sourceTransferItems      InternalTransferItem[]  @relation("SourceTransfer")
  destinationTransferItems InternalTransferItem[]  @relation("DestinationTransfer")
  grnItems                 GRNItem[]
  purchaseReturnItems      PurchaseReturnItem[]
  putAwayRules             PutAwayRule[]
  defaultForVariants       ProductVariant[]        @relation("DefaultBin")
  salesOrderItems          SalesOrderItem[]
  stockAllocations         StockAllocation[]
  customerReturnItems      CustomerReturnItem[]
  stockReevaluationItems   StockReevaluationItem[]

  @@unique([name, shelfId])
  @@index([godownId])
}

// ==========================================
// 4. UNIFIED BATCH & TRACEABILITY
// ==========================================

model Batch {
  id                     String                  @id @default(uuid())
  batchNumber            String                  @unique
  manufactureDate        DateTime?
  expiryDate             DateTime?
  status                 String                  @default("ACTIVE")
  productVariantId       String
  productVariant         ProductVariant          @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  inventoryBalances      InventoryBalance[]
  stockAllocations       StockAllocation[]
  createdAt              DateTime                @default(now())
  internalTransferItems  InternalTransferItem[]
  stockReevaluationItems StockReevaluationItem[]

  @@index([productVariantId])
}

// ==========================================
// 5. PRODUCTS & VARIANTS
// ==========================================

model Product {
  id          String  @id @default(uuid())
  sku         String  @unique
  name        String
  description String?

  maxPurchasePrice Decimal @default(0.00) @db.Decimal(12, 2)
  minSellingPrice  Decimal @default(0.00) @db.Decimal(12, 2)

  uomId String?
  uom   UomMaster? @relation(fields: [uomId], references: [id])
  taxId String?
  tax   TaxMaster? @relation(fields: [taxId], references: [id])

  minStockLevel Int     @default(0)
  isActive      Boolean @default(true)

  brandId    String
  subBrandId String?
  brand      Brand     @relation(fields: [brandId], references: [id])
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id])

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  productVariants ProductVariant[]

  @@index([sku])
  @@index([partnerId])
}

model ProductVariant {
  id            String  @id @default(uuid())
  productId     String
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku           String  @unique
  barcode       String? @unique
  name          String?
  isActive      Boolean @default(true)
  price         Decimal @default(0.00) @db.Decimal(12, 2)
  purchasePrice Decimal @default(0.00) @db.Decimal(12, 2)
  inventoryMode String  @default("SIMPLE")

  lengthCm  Decimal? @db.Decimal(10, 2)
  widthCm   Decimal? @db.Decimal(10, 2)
  heightCm  Decimal? @db.Decimal(10, 2)
  volumeCm3 Decimal? @db.Decimal(15, 2)
  weightKg  Decimal? @db.Decimal(10, 3)

  minStockLevel Int @default(10)
  currentStock  Int @default(0)

  defaultBinId String?
  defaultBin   Bin?    @relation("DefaultBin", fields: [defaultBinId], references: [id])

  batches               Batch[]
  inventoryBalances     InventoryBalance[]
  attributes            ProductVariantAttribute[]
  ledgerEntries         StockLedger[]
  salesOrderItems       SalesOrderItem[]
  purchaseOrderItems    PurchaseOrderItem[]
  grnItems              GRNItem[]
  customerReturnItems   CustomerReturnItem[]
  stockMovements        StockMovement[]
  internalTransferItems InternalTransferItem[]

  // Explicit relation tags for source vs target items during sorting
  stockReevaluationsAsOriginal StockReevaluationItem[] @relation("OriginalVariant")
  stockReevaluationsAsNew      StockReevaluationItem[] @relation("NewVariant")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([sku])
  @@index([barcode])
}

model InventoryBalance {
  id               String         @id @default(uuid())
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  binId String
  bin   Bin    @relation(fields: [binId], references: [id], onDelete: Cascade)

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Restrict)

  currentCount   Int     @default(0)
  allocatedCount Int     @default(0)
  currentKg      Decimal @default(0.0) @db.Decimal(12, 3)

  totalPurchasedCount Int @default(0)
  soldCount           Int @default(0)
  returnedCount       Int @default(0)

  createdAt         DateTime @default(now())
  lastStockMovement DateTime @default(now()) @updatedAt
  isActive          Boolean  @default(true)
  notes             String?

  @@unique([productVariantId, binId, batchId])
  @@index([binId])
  @@index([productVariantId])
  @@index([batchId])
}

model StockMovement {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // What happened?
  type        MovementType // e.g., GRN, SALES_OUT, ADJUSTMENT, TRANSFER
  referenceId String // ID of the GRN, Invoice, or Adjustment

  // How much? (Always signed: + for In, - for Out)
  quantity Int

  // Relation
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  binId            String
  batchId          String

  @@index([productVariantId, createdAt]) // Critical for performance
}

// ==========================================
// 6. VARIABLE ATTRIBUTE METADATA
// ==========================================

model AttributeDefinition {
  id       String                    @id @default(uuid())
  name     String                    @unique
  values   AttributeValue[]
  variants ProductVariantAttribute[]
}

model AttributeValue {
  id             String                    @id @default(uuid())
  attributeDefId String
  definition     AttributeDefinition       @relation(fields: [attributeDefId], references: [id], onDelete: Cascade)
  value          String
  hexCode        String?
  variants       ProductVariantAttribute[]

  @@unique([attributeDefId, value])
}

model ProductVariantAttribute {
  id String @id @default(uuid())

  productVariantId String
  variant          ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  attributeValueId String
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  attributeDefId String
  attributeDef   AttributeDefinition @relation(fields: [attributeDefId], references: [id], onDelete: Cascade)

  @@unique([productVariantId, attributeValueId])
  @@index([attributeDefId])
  @@index([productVariantId])
}

model UomMaster {
  id       String    @id @default(uuid())
  name     String    @unique
  symbol   String
  products Product[]
}

model TaxMaster {
  id         String    @id @default(uuid())
  name       String    @unique
  percentage Decimal   @db.Decimal(5, 2)
  isActive   Boolean   @default(true)
  products   Product[]
}

// ==========================================
// 7. DOUBLE-ENTRY STOCK TRANSACTION LEDGER
// ==========================================

model StockLedger {
  id               String         @id @default(uuid())
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  sourceBinId String?
  sourceBin   Bin?    @relation("SourceBin", fields: [sourceBinId], references: [id], onDelete: Restrict)

  destinationBinId String?
  destinationBin   Bin?    @relation("DestinationBin", fields: [destinationBinId], references: [id], onDelete: Restrict)

  quantityCount Int      @default(0)
  quantityKg    Decimal  @default(0.0) @db.Decimal(12, 3)
  type          LogType
  reference     String
  notes         String?
  createdAt     DateTime @default(now())

  @@index([productVariantId, createdAt])
  @@index([sourceBinId])
  @@index([destinationBinId])
}

model PutAwayRule {
  id          String          @id @default(uuid())
  name        String
  categoryId  String?
  category    Category?       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  strategy    PutAwayStrategy
  priority    Int             @default(5)
  targetBinId String?
  bin         Bin?            @relation(fields: [targetBinId], references: [id], onDelete: Cascade)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([categoryId])
  @@index([priority])
}

model InternalTransfer {
  id          String                 @id @default(uuid())
  transferRef String                 @unique
  processedBy String
  notes       String?
  createdAt   DateTime               @default(now())
  items       InternalTransferItem[]
}

model InternalTransferItem {
  id                 String           @id @default(uuid())
  internalTransferId String
  internalTransfer   InternalTransfer @relation(fields: [internalTransferId], references: [id], onDelete: Cascade)

  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  // 🔥 Required traceability field
  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Restrict)

  sourceBinId String
  sourceBin   Bin    @relation("SourceTransfer", fields: [sourceBinId], references: [id], onDelete: Restrict)

  destinationBinId String
  destinationBin   Bin    @relation("DestinationTransfer", fields: [destinationBinId], references: [id], onDelete: Restrict)

  quantityCount Int
  quantityKg    Decimal @default(0.0) @db.Decimal(12, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([batchId])
  @@index([internalTransferId])
  @@index([sourceBinId])
  @@index([destinationBinId])
}

// ==========================================
// 8. PURCHASING, GRN & RETURNS
// ==========================================

model PurchaseOrder {
  id             String  @id @default(uuid())
  purchaseNumber String  @unique
  partnerId      String
  partner        Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  createdById    String
  createdBy      User    @relation(fields: [createdById], references: [id])

  items         PurchaseOrderItem[]
  returns       PurchaseReturn[]
  grns          GRN[]
  transactions  Transaction[]
  reevaluations StockReevaluation[]

  subtotal      Decimal             @default(0.0) @db.Decimal(12, 2)
  taxAmount     Decimal             @default(0.0) @db.Decimal(12, 2)
  courierCost   Decimal             @default(0.0) @db.Decimal(12, 2)
  grandTotal    Decimal             @default(0.0) @db.Decimal(12, 2)
  totalAmount   Decimal             @default(0.0) @db.Decimal(12, 2)
  paidAmount    Decimal             @default(0.0) @db.Decimal(12, 2)
  dueAmount     Decimal             @default(0.0) @db.Decimal(12, 2)
  paymentStatus PaymentStatus       @default(UNPAID)
  status        PurchaseOrderStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partnerId])
}

model PurchaseOrderItem {
  id               String         @id @default(uuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  quantityCount Int
  quantityKg    Decimal @default(0.0) @db.Decimal(12, 3)
  unitCost      Decimal @db.Decimal(12, 2)
  totalPrice    Decimal @db.Decimal(12, 2)

  @@index([purchaseOrderId])
  @@index([productVariantId])
}

model GRN {
  id                 String              @id @default(uuid())
  grnNumber          String              @unique
  purchaseOrderId    String
  purchaseOrder      PurchaseOrder       @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  receivedAt         DateTime            @default(now())
  receivedBy         String
  status             PurchaseOrderStatus @default(RECEIVED)
  items              GRNItem[]
  stockReevaluations StockReevaluation[]
}

model GRNItem {
  id               String         @id @default(uuid())
  grnId            String
  grn              GRN            @relation(fields: [grnId], references: [id], onDelete: Cascade)
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  binId String
  bin   Bin    @relation(fields: [binId], references: [id], onDelete: Restrict)

  quantityCount Int
  quantityKg    Decimal @default(0.0) @db.Decimal(12, 3)

  @@index([binId])
  @@index([grnId])
}

model PurchaseReturn {
  id              String               @id @default(uuid())
  returnNumber    String               @unique
  purchaseOrderId String
  purchaseOrder   PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  refundAmount    Decimal              @db.Decimal(12, 2)
  processedBy     String
  notes           String?
  createdAt       DateTime             @default(now())
  items           PurchaseReturnItem[]
}

model PurchaseReturnItem {
  id               String         @id @default(uuid())
  purchaseReturnId String
  purchaseReturn   PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  productVariantId String
  binId            String
  bin              Bin            @relation(fields: [binId], references: [id], onDelete: Restrict)
  quantityCount    Int
  quantityKg       Decimal        @default(0.0) @db.Decimal(12, 3)
  reason           ReturnReason

  @@index([binId])
  @@index([purchaseReturnId])
}

// ==========================================
// 9. SALES & RESERVATION ORDERS
// ==========================================

model Customer {
  id          String       @id @default(uuid())
  name        String
  phone       String       @unique
  email       String?
  salesOrders SalesOrder[]
  createdAt   DateTime     @default(now())
}

model SalesOrder {
  id             String           @id @default(uuid())
  invoiceNumber  String           @unique
  orderRef       String           @unique
  buyerName      String?
  createdById    String
  createdBy      User             @relation(fields: [createdById], references: [id])
  partnerId      String
  partner        Partner          @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  customerId     String
  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items          SalesOrderItem[]
  returns        CustomerReturn[]
  transactions   Transaction[]
  payments       Payment[]
  totalAmount    Decimal          @db.Decimal(12, 2)
  receivedAmount Decimal          @default(0.0) @db.Decimal(12, 2)
  balanceDue     Decimal          @default(0.0) @db.Decimal(12, 2)
  courierCost    Decimal          @default(0.0) @db.Decimal(12, 2)
  taxAmount      Decimal          @default(0.0) @db.Decimal(12, 2)
  taxName        String?
  taxRate        Decimal?         @db.Decimal(5, 2)
  paymentMethod  PaymentMethod
  status         SalesOrderStatus @default(DRAFT)
  notes          String?
  pickLists      PickList[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([partnerId])
  @@index([customerId])
  @@index([invoiceNumber])
}

model SalesOrderItem {
  id               String         @id @default(uuid())
  salesOrderId     String
  salesOrder       SalesOrder     @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  orderedQuantity Int
  quantityCount   Int     @default(0)
  quantityKg      Decimal @default(0.0) @db.Decimal(12, 3)
  unitPrice       Decimal @db.Decimal(12, 2)
  totalPrice      Decimal @db.Decimal(12, 2)

  allocations StockAllocation[]
  binId       String?
  bin         Bin?              @relation(fields: [binId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salesOrderId])
  @@index([productVariantId])
}

model StockAllocation {
  id               String         @id @default(uuid())
  salesOrderItemId String
  salesOrderItem   SalesOrderItem @relation(fields: [salesOrderItemId], references: [id], onDelete: Cascade)
  batchId          String
  batch            Batch          @relation(fields: [batchId], references: [id], onDelete: Restrict)
  binId            String
  bin              Bin            @relation(fields: [binId], references: [id], onDelete: Restrict)

  // NEW FIELD
  pickListId String?
  pickList   PickList? @relation(fields: [pickListId], references: [id], onDelete: SetNull)

  allocatedCount Int
  createdAt      DateTime @default(now())

  @@index([batchId])
  @@index([binId])
  @@index([pickListId]) // NEW INDEX
}

model CustomerReturn {
  id           String               @id @default(uuid())
  returnNumber String               @unique
  salesOrderId String
  salesOrder   SalesOrder           @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  refundAmount Decimal              @db.Decimal(12, 2)
  items        CustomerReturnItem[]
  notes        String?
  createdAt    DateTime             @default(now())
}

model CustomerReturnItem {
  id               String         @id @default(uuid())
  customerReturnId String
  customerReturn   CustomerReturn @relation(fields: [customerReturnId], references: [id], onDelete: Cascade)
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  binId            String
  bin              Bin            @relation(fields: [binId], references: [id], onDelete: Restrict)
  quantityCount    Int
  quantityKg       Decimal        @default(0.0) @db.Decimal(12, 3)
  reason           ReturnReason

  @@index([customerReturnId])
}

model Payment {
  id            String        @id @default(uuid())
  salesOrderId  String
  salesOrder    SalesOrder    @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  amount        Decimal       @db.Decimal(12, 2)
  paymentDate   DateTime      @default(now())
  paymentMethod PaymentMethod @default(CASH)
  notes         String?
}

model Partner {
  id          String      @id @default(uuid())
  type        PartnerType
  companyName String
  name        String
  phone       String      @unique
  email       String?
  address     String
  creditLimit Decimal     @default(0.00) @db.Decimal(12, 2)
  balance     Decimal     @default(0.00) @db.Decimal(12, 2)

  bankName  String?
  accountNo String?
  ifscCode  String?
  taxId     String?
  createdAt DateTime @default(now())

  purchaseOrders PurchaseOrder[]
  salesOrders    SalesOrder[]
  transactions   Transaction[]
  products       Product[]
}

model Transaction {
  id              String          @id @default(uuid())
  partnerId       String
  partner         Partner         @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  type            TransactionType
  amount          Decimal         @db.Decimal(12, 2)
  date            DateTime        @default(now())
  paymentMethod   PaymentMethod
  salesOrderId    String?
  salesOrder      SalesOrder?     @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  notes           String?
}

model PickList {
  id         String @id @default(uuid())
  pickNumber String @unique

  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   User?   @relation("PickerTasks", fields: [assignedToId], references: [id])

  status      PickStatus        @default(PENDING)
  allocations StockAllocation[] // Links directly to the bins/batches they need to pick

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salesOrderId])
  @@index([assignedToId])
}

// ==========================================
// 10. STOCK SORTING & RE-EVALUATION
// ==========================================

model StockReevaluation {
  id String @id @default(uuid())

  purchaseOrderId String? // <--- Add '?' here
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull) // <--- Add '?' here too

  grnId String?
  grn   GRN?    @relation(fields: [grnId], references: [id], onDelete: SetNull)

  performedById String
  performedBy   User   @relation(fields: [performedById], references: [id], onDelete: Restrict)

  notes     String?
  createdAt DateTime @default(now())

  items StockReevaluationItem[]

  @@index([purchaseOrderId])
  @@index([grnId])
}

model StockReevaluationItem {
  id             String            @id @default(uuid())
  reevaluationId String
  reevaluation   StockReevaluation @relation(fields: [reevaluationId], references: [id], onDelete: Cascade)

  // The original item that is being deducted (e.g., 2GB RAM)
  originalVariantId String
  originalVariant   ProductVariant @relation("OriginalVariant", fields: [originalVariantId], references: [id], onDelete: Restrict)

  // The new item that is being added (e.g., 8GB or 16GB RAM)
  newVariantId String
  newVariant   ProductVariant @relation("NewVariant", fields: [newVariantId], references: [id], onDelete: Restrict)

  // Location and Traceability
  binId   String
  bin     Bin    @relation(fields: [binId], references: [id], onDelete: Restrict)
  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Restrict)

  // Quantities and Financials
  quantityConverted Int
  unitCost          Decimal @db.Decimal(12, 2) // Preserves the PO item's unit cost balance

  createdAt DateTime @default(now())

  @@index([reevaluationId])
  @@index([originalVariantId])
  @@index([newVariantId])
  @@index([binId])
  @@index([batchId])
}

